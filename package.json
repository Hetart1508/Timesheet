{
  "name": "timesheet-management",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,green \"npm run dev -w client\" \"npm run dev -w server\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "test": "npm run test -w server && npm run test -w client",
    "test:server": "npm run test -w server",
    "test:client": "npm run test -w client",
    "db:migrate": "npm run db:migrate -w server",
    "db:status": "npm run db:status -w server",
    "db:seed": "npm run db:seed -w server",
    "admin:bootstrap": "npm run admin:bootstrap -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
