# Shared local-development defaults. Copy this file to .env.
NODE_ENV=development
CLIENT_PORT=5173
SERVER_PORT=5000
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Runtime MySQL account (do not use root outside local development)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=timesheet_management
DB_USER=timesheet_app
DB_PASSWORD=replace_with_a_strong_local_password
DB_CONNECTION_LIMIT=10
DB_SSL=false

# A separate database is mandatory when NODE_ENV=test.
TEST_DB_NAME=timesheet_management_test

# Phase 2 secrets (must be replaced before authentication is enabled)
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_ISSUER=timesheet-management
JWT_AUDIENCE=timesheet-web
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=
PASSWORD_MIN_LENGTH=12

# Business rules
BUSINESS_TIMEZONE=Asia/Kolkata
APPROVAL_REQUIRED=true

# Email. DEV_EMAIL_MODE may only be true outside production.
DEV_EMAIL_MODE=true
BREVO_API_KEY=
BREVO_SENDER_NAME=Timesheet Management
BREVO_SENDER_EMAIL=

